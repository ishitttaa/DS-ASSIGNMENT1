#include <bits/stdc++.h>
using namespace std;

int main() {
    int V = 5;
    vector<pair<int,int>> adj[V];

    adj[0].push_back({1,2});
    adj[1].push_back({0,2});

    adj[0].push_back({3,6});
    adj[3].push_back({0,6});

    adj[1].push_back({2,3});
    adj[2].push_back({1,3});

    priority_queue<pair<int,int>, vector<pair<int,int>>, greater<pair<int,int>>> pq;

    vector<int> key(V, INT_MAX), parent(V, -1);
    vector<bool> mst(V, false);

    key[0] = 0;
    pq.push({0,0});

    while(!pq.empty()) {
        int node = pq.top().second;
        pq.pop();

        mst[node] = true;

        for(auto &it : adj[node]) {
            int nbr = it.first, wt = it.second;

            if(!mst[nbr] && wt < key[nbr]) {
                key[nbr] = wt;
                parent[nbr] = node;
                pq.push({key[nbr], nbr});
            }
        }
    }

    int total = 0;
    for(int i=1;i<V;i++) total += key[i];
    cout << "MST Weight = " << total;
}
